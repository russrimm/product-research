# Azure OpenAI / Foundry (leave blank to run in offline "mock AI" mode)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Reddit OAuth app (https://www.reddit.com/prefs/apps, type "script" or "web app")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=product-research/0.1 (by u/your-username)

# Microsoft Learn MCP server
LEARN_MCP_URL=https://learn.microsoft.com/api/mcp

# Storage
DATABASE_PATH=./data/research.db

# Protects POST /api/ingest (send as "Authorization: Bearer <token>")
INGEST_TOKEN=change-me

# Set to "true" to run the cron ingestion loop inside the Next.js server
ENABLE_INTERNAL_SCHEDULER=false
INGEST_CRON_MINUTES=60
